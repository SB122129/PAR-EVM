{
  "name": "cc.getportal.portal",
  "main": "index.ts",
  "version": "1.0.11",
  "type": "module",
  "scripts": {
    "ai:server": "node ./debug-scripts/ai-recommendation-server.mjs",
    "start:expo": "expo start",
    "start:web": "expo start --web --clear",
    "start:dev-client": "expo start --dev-client --tunnel",
    "start": "npm run typecheck && npm run check && expo start",
    "android": "npm run typecheck && npm run check && expo run:android",
    "android-release": "npm run typecheck && npm run check && expo run:android --variant release",
    "ios": "npm run typecheck && npm run check && expo run:ios",
    "test": "jest --watchAll",
    "typecheck": "node ./debug-scripts/typecheck.mjs",
    "lint": "biome lint --diagnostic-level=error .",
    "lint:warnings": "biome lint --diagnostic-level=warn .",
    "lint:strict": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write --diagnostic-level=error .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --diagnostic-level=error .",
    "check:warnings": "biome check --diagnostic-level=warn .",
    "check:strict": "biome check --error-on-warnings .",
    "check:fix": "biome check --write --diagnostic-level=error .",
    "prepare": "husky"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@noble/hashes": "^2.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@reown/appkit": "^1.0.0",
    "@walletconnect/ethereum-provider": "^2.23.7",
    "bip39": "^3.1.0",
    "date-fns": "^4.1.0",
    "expo": "~54.0.33",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.10",
    "light-bolt11-decoder": "^3.2.0",
    "lottie-react-native": "~7.3.1",
    "lucide-react-native": "~0.516.0",
    "nostr-tools": "~2.12.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "~5.5.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-input-select": "^2.1.3",
    "react-native-nfc-manager": "^3.16.1",
    "react-native-qrcode-svg": "^6.3.20",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-uuid": "^2.0.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "use-debounce": "^10.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@biomejs/biome": "^2.3.10",
    "@react-native-community/cli": "latest",
    "@types/jest": "~29.5.12",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.0.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "lint-staged": "^16.2.7",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-native-nfc-manager"
        ]
      }
    }
  },
  "private": true,
  "packageManager": "npm@10.0.0"
}
